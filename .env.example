# Database — Postgres (Supabase). Use the pooled connection string from
# Supabase → Settings → Database. Example:
#   postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# For zero-config local development you can instead switch the provider in
# prisma/schema.prisma to "sqlite" and use DATABASE_URL="file:./dev.db".
DATABASE_URL=""

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET="change-me-in-production"

# Meta (Facebook) tracking. Can also be configured from Admin → Settings,
# which takes precedence over these values.
META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
META_TEST_EVENT_CODE=""

# Public site URL (used for canonical URLs / sitemap / OG tags)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
