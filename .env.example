# Database — SQLite for development. For production point this at
# Supabase/Postgres and change prisma/schema.prisma provider to "postgresql".
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET="change-me-in-production"

# Meta (Facebook) tracking. Can also be configured from Admin → Settings,
# which takes precedence over these values.
META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
META_TEST_EVENT_CODE=""

# Public site URL (used for canonical URLs / sitemap / OG tags)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
